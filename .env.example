# ============================================
# SHAGHOOF AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ------------------------------------------
# 🤖 AI Provider — Groq Cloud (Required)
# ------------------------------------------
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------
# 🔑 OpenAI (Optional — Legacy Streamlit Module)
# ------------------------------------------
# Only needed if running the legacy edumind/ Streamlit app
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------
# 🔒 Security
# ------------------------------------------
# Secret key for JWT signing. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
